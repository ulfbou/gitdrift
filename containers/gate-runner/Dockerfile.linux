FROM python:3.11-slim-bookworm@sha256:f06d01d4ba3f8ad5af45a3ec87df19c1d317d8e8961edc0fabda61811af6f7cf

ARG RUNNER_REVISION
LABEL org.opencontainers.image.title="Gitdrift gate runner"
LABEL org.opencontainers.image.description="Reusable Linux runner for Gitdrift acceptance gates"
LABEL org.opencontainers.image.source="https://github.com/ulfbou/gitdrift"
LABEL org.opencontainers.image.revision="${RUNNER_REVISION}"
LABEL dev.gitdrift.runner.contract="gitdrift-gate-runner-v1"
LABEL dev.gitdrift.runner.platform="Linux"
LABEL dev.gitdrift.runner.candidate-embedded="false"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace/src:/workspace/tests

RUN apt-get update     && apt-get install --yes --no-install-recommends git ca-certificates     && rm -rf /var/lib/apt/lists/*     && useradd --create-home --uid 10001 --shell /usr/sbin/nologin gate     && mkdir -p /runner /request /workspace /evidence     && chown -R gate:gate /runner /request /workspace /evidence

COPY --chown=gate:gate entrypoint.py gates.json /runner/

USER gate:gate
WORKDIR /runner
ENTRYPOINT ["python", "/runner/entrypoint.py", "--manifest", "/runner/gates.json"]
CMD ["inspect"]
